{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "Name": "Local Services Marketplace",
    "BrandShort": "Kaarigar",
    "PublicBaseUrl": "http://localhost:5080"
  },
  "Marketplace": {
    "CommissionRate": 0.10,
    "CancellationWindowHours": 2,
    "MinBookingLeadMinutes": 60,
    "MaxReschedules": 2,
    "AllowEarlyCompletion": true,
    "TimeZone": "Asia/Kolkata",
    "Culture": "en-IN",
    "Cities": [ "New Delhi", "Noida", "Gurugram", "Mumbai", "Bengaluru", "Pune", "Hyderabad", "Chennai" ]
  },
  "Jwt": {
    "Issuer": "LocalServicesMarketplace",
    "Audience": "LocalServicesMarketplace.Api",
    "Key": "",
    "ExpiryMinutes": 120
  },
  "Seed": {
    "Enabled": false,
    "SampleData": true,
    "AdminEmail": "",
    "AdminPassword": "",
    "DemoUserPassword": "Demo@12345"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "FromAddress": "no-reply@kaarigar.test",
    "FromName": "Kaarigar",
    "SupportAddress": "support@kaarigar.test"
  },
  "Storage": {
    "Root": "storage",
    "MaxProfileImageBytes": 2097152,
    "MaxDocumentBytes": 5242880
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  }
}
