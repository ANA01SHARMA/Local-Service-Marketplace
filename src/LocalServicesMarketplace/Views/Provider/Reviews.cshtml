@model PagedResult<ReviewVm>
@{ var p = (Provider)ViewBag.Provider; }
<div class="row g-4">
    <div class="col-xl-4">
        <div class="surface surface-pad text-center">
            <div class="display-4 fw-bold" style="font-family:var(--font-display)">@(p.TotalReviews > 0 ? p.AverageRating.ToString("0.0") : "–")</div>
            <stars value="@p.AverageRating" />
            <p class="small text-muted mt-2">Average from @p.TotalReviews review@(p.TotalReviews == 1 ? "" : "s"). Calculated by the CalculateProviderAverageRating stored procedure after each new review.</p>
            <a class="btn btn-outline-ink btn-sm" href="/providers/@p.Id#reviews" target="_blank">See them on your profile</a>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="surface">
            <div class="surface-head"><h2>Customer reviews</h2></div>
            @if (Model.Items.Count == 0)
            {
                <div class="empty"><i class="bi bi-star" aria-hidden="true"></i><h3>No reviews yet</h3><p>Customers can review you after you mark their booking as completed.</p></div>
            }
            <div class="px-4">
                @foreach (var r in Model.Items)
                {
                    <article class="review">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <div class="d-flex gap-2 align-items-center"><avatar name="@r.CustomerName" size="sm" /><div><strong class="small d-block">@r.CustomerName</strong><span class="small text-muted">@r.ServiceTitle, <a asp-controller="Booking" asp-action="Details" asp-route-id="@r.BookingId">@Booking.FormatReference(r.BookingId)</a></span></div></div>
                            <div class="text-end"><stars value="@r.Rating" /><div class="small text-muted">@Tz.Format(r.CreatedAtUtc, "d MMM yyyy")</div></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment)) { <p class="mt-2 mb-0">@r.Comment</p> }
                    </article>
                }
            </div>
        </div>
        <div class="d-flex justify-content-center mt-3"><pager page="@Model.Page" total-pages="@Model.TotalPages" /></div>
    </div>
</div>
