@model VerificationViewModel
@{ var p = Model.Provider; }
<div class="row g-4">
    <div class="col-xl-7 d-grid gap-4 align-content-start">
        <div class="surface surface-pad">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="small-label">Verification status</div>
                    <div class="d-flex align-items-center gap-2 mt-1"><span class="badge-status @p.VerificationStatus.BadgeClass() fs-6">@p.VerificationStatus.Label()</span></div>
                </div>
                @if (p.VerificationSubmittedAtUtc.HasValue)
                {
                    <div class="small text-muted text-end">
                        <div>Submitted @Tz.Format(p.VerificationSubmittedAtUtc.Value)</div>
                        @if (p.VerifiedAtUtc.HasValue) { <div>Approved @Tz.Format(p.VerifiedAtUtc.Value)</div> }
                    </div>
                }
            </div>
            @if (p.VerificationStatus == VerificationStatus.Rejected && !string.IsNullOrEmpty(p.VerificationNote))
            {
                <div class="alert alert-danger mt-3 mb-0"><strong>Admin note:</strong> @p.VerificationNote</div>
            }
            @if (p.VerificationStatus == VerificationStatus.Approved)
            {
                <p class="mt-3 mb-0">You're verified. Customers see the verified badge on your profile and can book your published slots.</p>
            }
            else if (p.VerificationStatus == VerificationStatus.Pending)
            {
                <p class="mt-3 mb-0">An admin is reviewing your documents. This usually takes less than a day.</p>
            }
            else
            {
                <form asp-action="SubmitVerification" method="post" class="mt-3">
                    <button class="btn btn-primary" type="submit" @(Model.CanSubmit ? "" : "disabled")>Submit for verification</button>
                    @if (!Model.CanSubmit) { <span class="small text-muted ms-2">Complete the checklist first.</span> }
                </form>
            }
        </div>

        <div class="surface">
            <div class="surface-head"><h2>Your documents</h2><span class="small text-muted"><i class="bi bi-lock" aria-hidden="true"></i> Only you and admins can see these</span></div>
            <div class="px-4">
                @if (Model.Documents.Count == 0)
                {
                    <div class="empty"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i><h3>No documents yet</h3><p>Upload a government ID. Add a trade certificate if you have one.</p></div>
                }
                @foreach (var d in Model.Documents)
                {
                    <div class="doc-row">
                        <span class="file-icon"><i class="bi @(d.ContentType == "application/pdf" ? "bi-file-earmark-pdf" : "bi-file-earmark-image")" aria-hidden="true"></i></span>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-650">@d.DocumentType.Label()</div>
                            <div class="small text-muted text-truncate">@d.OriginalFileName, @(d.FileSizeBytes / 1024) KB, uploaded @Tz.Format(d.UploadedAtUtc, "d MMM")</div>
                            @if (!string.IsNullOrEmpty(d.ReviewNote)) { <div class="small text-danger">@d.ReviewNote</div> }
                        </div>
                        <span class="badge-status @d.Status.BadgeClass()">@d.Status</span>
                        <a class="btn btn-outline-ink btn-sm" asp-action="Document" asp-route-id="@d.Id" target="_blank">View</a>
                        @if (d.Status != DocumentStatus.Approved && p.VerificationStatus != VerificationStatus.Pending)
                        {
                            <form asp-action="DeleteDocument" asp-route-id="@d.Id" method="post" data-confirm="Delete this document?"><button class="btn btn-soft-danger btn-sm" type="submit" aria-label="Delete document"><i class="bi bi-trash" aria-hidden="true"></i></button></form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-5 d-grid gap-4 align-content-start">
        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="surface">
            <div class="surface-head"><h2>Upload a document</h2></div>
            <div class="surface-pad d-grid gap-3">
                <div><label class="form-label" for="Upload_DocumentType">Document type</label><select class="form-select" id="Upload_DocumentType" name="Upload.DocumentType" asp-items="@Html.GetEnumSelectList<DocumentType>()"></select></div>
                <div><label class="form-label" for="Upload_File">File (PDF, JPG or PNG, max 5 MB)</label><input class="form-control" type="file" id="Upload_File" name="Upload.File" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                <button class="btn btn-navy" type="submit">Upload</button>
                <p class="small text-muted mb-0">Files are checked by type and content, renamed, and stored outside the public website.</p>
            </div>
        </form>
        <div class="surface surface-pad">
            <h2 class="h5">Checklist</h2>
            <ul class="checklist">
                @foreach (var c in Model.Checklist)
                {
                    <li class="@(c.Done ? "done" : "")"><span class="tick"><i class="bi bi-check-lg" aria-hidden="true"></i></span><span class="text flex-grow-1 small">@c.Label</span>@if (!c.Done && c.Action != "/Provider/Verification") { <a class="small fw-650" href="@c.Action">Do it</a> }</li>
                }
            </ul>
        </div>
    </div>
</div>
