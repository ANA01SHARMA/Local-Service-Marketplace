@model ReviewInputModel
@{ Layout = "_DashboardLayout"; var b = Model.Booking!; }
<div class="row g-4">
    <div class="col-xl-7">
        <form asp-action="Review" method="post" class="surface surface-pad" novalidate>
            <input type="hidden" asp-for="BookingId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="d-flex gap-3 align-items-center mb-4">
                <avatar name="@b.Provider.User.FullName" src="@b.Provider.User.ProfileImagePath" size="lg" />
                <div>
                    <h2 class="h4 m-0">How was @b.Provider.User.FullName?</h2>
                    <div class="text-muted">@b.Service.Title on @Tz.Format(b.ScheduledStartUtc, "d MMM yyyy")</div>
                </div>
            </div>
            <fieldset class="mb-3">
                <legend class="form-label">Your rating</legend>
                <div class="star-input">
                    @for (var i = 5; i >= 1; i--)
                    {
                        <input type="radio" id="star@(i)" name="Rating" value="@i" @(Model.Rating == i ? "checked" : "") data-val="true" data-val-required="Choose a rating from 1 to 5 stars." />
                        <label for="star@(i)" title="@i star@(i == 1 ? "" : "s")"><span class="visually-hidden">@i star@(i == 1 ? "" : "s")</span>★</label>
                    }
                </div>
                <div><span asp-validation-for="Rating"></span></div>
            </fieldset>
            <div class="mb-4">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="5" placeholder="Was the professional on time? Was the work done well? Would you book again?"></textarea>
                <span asp-validation-for="Comment"></span>
            </div>
            <button type="submit" class="btn btn-primary">Post review</button>
            <a class="btn btn-link" asp-action="Details" asp-route-id="@b.Id">Not now</a>
        </form>
    </div>
    <div class="col-xl-5">
        <div class="surface surface-pad">
            <h2 class="h5">About reviews</h2>
            <p class="small text-muted mb-0">Reviews are public on the professional's profile with your name. You can review each completed booking once, and reviews can't be edited after posting.</p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
