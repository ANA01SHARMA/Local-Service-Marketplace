@using System.Globalization
@model ServicesIndexViewModel
@{
    var q = Model.Query;
    var inv = CultureInfo.InvariantCulture;

    // Current query as a dictionary, so links can change or drop one value and keep the rest.
    Dictionary<string, string?> Current() => new()
    {
        ["q"] = q.Q,
        ["category"] = q.Category,
        ["city"] = q.City,
        ["minPrice"] = q.MinPrice?.ToString("0.##", inv),
        ["maxPrice"] = q.MaxPrice?.ToString("0.##", inv),
        ["minRating"] = q.MinRating?.ToString("0.#", inv),
        ["availableOn"] = q.AvailableOn?.ToString("yyyy-MM-dd", inv),
        ["sort"] = q.Sort
    };
    string Link(params (string Key, string? Value)[] changes)
    {
        var d = Current();
        foreach (var (k, v) in changes) d[k] = v;
        var qs = string.Join("&", d.Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"));
        return "/Services" + (qs.Length > 0 ? "?" + qs : "");
    }
    // Switching category keeps search, city, rating, date and sort; price ranges differ by trade, so they reset.
    string CategoryHref(string? slug) => Link(("category", slug), ("minPrice", null), ("maxPrice", null));

    var active = new List<(string Label, string Href)>();
    if (!string.IsNullOrWhiteSpace(q.Q)) active.Add(($"“{q.Q}”", Link(("q", null))));
    if (!string.IsNullOrWhiteSpace(q.City)) active.Add((q.City!, Link(("city", null))));
    if (q.MinPrice.HasValue || q.MaxPrice.HasValue)
    {
        var label = q.MinPrice.HasValue && q.MaxPrice.HasValue ? $"{q.MinPrice.ToMoney()} to {q.MaxPrice.ToMoney()}"
                  : q.MinPrice.HasValue ? $"From {q.MinPrice.ToMoney()}" : $"Up to {q.MaxPrice.ToMoney()}";
        active.Add((label, Link(("minPrice", null), ("maxPrice", null))));
    }
    if (q.MinRating.HasValue) active.Add(($"{q.MinRating:0.#}+ stars", Link(("minRating", null))));
    if (q.AvailableOn.HasValue) active.Add(($"Free on {q.AvailableOn.Value.ToString("ddd d MMM")}", Link(("availableOn", null))));
    var panelFilterCount = active.Count - (string.IsNullOrWhiteSpace(q.Q) ? 0 : 1);
    var clearHref = Link(("q", null), ("city", null), ("minPrice", null), ("maxPrice", null), ("minRating", null), ("availableOn", null));

    var sorts = new (string Value, string Label)[]
    {
        ("rating", "Top rated"), ("soonest", "Available soonest"), ("price_asc", "Price: low to high"),
        ("price_desc", "Price: high to low"), ("experience", "Most experienced"), ("reviews", "Most reviewed")
    };
    var sort = string.IsNullOrEmpty(q.Sort) ? "rating" : q.Sort;
    var total = Model.Results.TotalCount;
}

<section class="page-hero services-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                @if (Model.ActiveCategory is not null)
                {
                    <li class="breadcrumb-item"><a asp-action="Index">Services</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.ActiveCategory.Name</li>
                }
                else
                {
                    <li class="breadcrumb-item active" aria-current="page">Services</li>
                }
            </ol>
        </nav>
        <div class="services-hero-grid">
            <div class="services-hero-intro">
                @if (Model.ActiveCategory?.ImagePath is { } art)
                {
                    <span class="services-hero-art" aria-hidden="true"><img src="@art" alt="" width="72" height="72" /></span>
                }
                <div class="min-w-0">
                    <h1>@(Model.ActiveCategory?.Name ?? "Find a professional")</h1>
                    <p class="services-hero-sub">@(Model.ActiveCategory?.Description ?? "Compare verified professionals by price, rating and the next time they are free.")</p>
                </div>
            </div>
            <form method="get" action="/Services" class="search-bar" role="search">
                @if (!string.IsNullOrEmpty(q.Category)) { <input type="hidden" name="category" value="@q.Category" /> }
                @if (!string.IsNullOrEmpty(q.City)) { <input type="hidden" name="city" value="@q.City" /> }
                @if (!string.IsNullOrEmpty(q.Sort)) { <input type="hidden" name="sort" value="@q.Sort" /> }
                <i class="bi bi-search" aria-hidden="true"></i>
                <label class="visually-hidden" for="topSearch">Search services</label>
                <input id="topSearch" type="search" name="q" value="@q.Q" placeholder="Service, skill or name" autocomplete="off" />
                <button class="btn btn-primary" type="submit">Search</button>
            </form>
        </div>
        <nav class="cat-pills scroll-x" aria-label="Categories" data-scroll-x>
            <a class="chip @(string.IsNullOrEmpty(q.Category) ? "active" : "")" href="@CategoryHref(null)" aria-current="@(string.IsNullOrEmpty(q.Category) ? "page" : null)"><i class="bi bi-grid" aria-hidden="true"></i>All services</a>
            @foreach (var c in Model.Categories)
            {
                var isActive = string.Equals(q.Category, c.Slug, StringComparison.OrdinalIgnoreCase);
                <a class="chip @(isActive ? "active" : "")" href="@CategoryHref(c.Slug)" aria-current="@(isActive ? "page" : null)"><i class="bi @c.Icon" aria-hidden="true"></i>@c.Name</a>
            }
        </nav>
    </div>
</section>

<section class="services-body">
    <div class="container">
        <div class="results-bar">
            <div class="results-summary">
                <h2 class="results-count" aria-live="polite"><span class="n">@total</span> professional@(total == 1 ? "" : "s")</h2>
                @if (active.Count > 0)
                {
                    <ul class="active-filters" aria-label="Active filters">
                        @foreach (var f in active)
                        {
                            <li><a class="filter-tag" href="@f.Href" aria-label="Remove filter @f.Label">@f.Label<i class="bi bi-x" aria-hidden="true"></i></a></li>
                        }
                        <li><a class="clear-link" href="@clearHref">Clear all</a></li>
                    </ul>
                }
            </div>
            <div class="results-actions">
                <button class="btn btn-outline-ink d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel" aria-expanded="false" aria-controls="filterPanel">
                    <i class="bi bi-sliders2 me-1" aria-hidden="true"></i><span>Filters</span>@if (panelFilterCount > 0) { <span class="filter-count" aria-label="@panelFilterCount active">@panelFilterCount</span> }
                </button>
                <form method="get" action="/Services" class="sort-form">
                    @foreach (var kv in Current().Where(kv => kv.Key != "sort" && !string.IsNullOrEmpty(kv.Value)))
                    {
                        <input type="hidden" name="@kv.Key" value="@kv.Value" />
                    }
                    <label for="fSort">Sort by</label>
                    <select id="fSort" name="sort" class="form-select" data-autosubmit>
                        @foreach (var s in sorts) { <option value="@s.Value" selected="@(sort == s.Value)">@s.Label</option> }
                    </select>
                    <noscript><button class="btn btn-outline-ink" type="submit">Sort</button></noscript>
                </form>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-3">
                <noscript><style>#filterPanel { display: block; }</style></noscript>
                <div id="filterPanel" class="collapse d-lg-block">
                    <form method="get" action="/Services" class="surface filter-panel" aria-label="Filters" data-filter-form>
                        @if (!string.IsNullOrEmpty(q.Q)) { <input type="hidden" name="q" value="@q.Q" /> }
                        @if (!string.IsNullOrEmpty(q.Category)) { <input type="hidden" name="category" value="@q.Category" /> }
                        @if (!string.IsNullOrEmpty(q.Sort)) { <input type="hidden" name="sort" value="@q.Sort" /> }
                        <div class="filter-head">
                            <h2>Filters</h2>
                            @if (panelFilterCount > 0) { <a href="@clearHref">Reset all</a> }
                        </div>

                        <div class="filter-group" data-filter-group>
                            <div class="filter-label">
                                <label for="fCity">City</label>
                                <button type="button" class="filter-clear" data-clear hidden>Clear</button>
                            </div>
                            <select id="fCity" name="city" class="form-select">
                                <option value="">Any city</option>
                                @foreach (var city in Model.Cities) { <option selected="@(city == q.City)">@city</option> }
                            </select>
                        </div>

                        <div class="filter-group" data-filter-group>
                            <div class="filter-label">
                                <span id="priceLabel">Price per job</span>
                                <button type="button" class="filter-clear" data-clear hidden>Clear</button>
                            </div>
                            <div class="price-range" role="group" aria-labelledby="priceLabel">
                                <label class="visually-hidden" for="fMin">Minimum price in rupees</label>
                                <span class="money-input"><span aria-hidden="true">₹</span><input id="fMin" class="form-control" type="number" inputmode="numeric" min="0" step="50" name="minPrice" value="@q.MinPrice?.ToString("0.##", inv)" placeholder="Min" /></span>
                                <span class="to" aria-hidden="true">to</span>
                                <label class="visually-hidden" for="fMax">Maximum price in rupees</label>
                                <span class="money-input"><span aria-hidden="true">₹</span><input id="fMax" class="form-control" type="number" inputmode="numeric" min="0" step="50" name="maxPrice" value="@q.MaxPrice?.ToString("0.##", inv)" placeholder="Max" /></span>
                            </div>
                        </div>

                        <div class="filter-group" data-filter-group>
                            <div class="filter-label">
                                <span id="ratingLabel">Rating</span>
                                <button type="button" class="filter-clear" data-clear hidden>Clear</button>
                            </div>
                            <div class="seg" role="radiogroup" aria-labelledby="ratingLabel">
                                @foreach (var r in new decimal?[] { null, 3m, 4m, 4.5m })
                                {
                                    var id = r is null ? "rAny" : $"r{r.Value.ToString("0.#", inv).Replace(".", "_")}";
                                    <input type="radio" name="minRating" id="@id" value="@(r?.ToString("0.#", inv) ?? "")" checked="@(q.MinRating == r)" />
                                    <label for="@id">@if (r is null) { <text>Any</text> } else { <i class="bi bi-star-fill" aria-hidden="true"></i>@r.Value.ToString("0.#")<text>+</text><span class="visually-hidden"> stars</span> }</label>
                                }
                            </div>
                        </div>

                        @{
                            var today = Tz.LocalToday;
                            var quickDays = Enumerable.Range(0, 7).Select(i => today.AddDays(i)).ToList();
                            var laterDate = q.AvailableOn.HasValue && !quickDays.Contains(q.AvailableOn.Value) ? q.AvailableOn : null;
                        }
                        <div class="filter-group" data-filter-group>
                            <div class="filter-label">
                                <span id="dateLabel">Free on</span>
                                <button type="button" class="filter-clear" data-clear hidden>Clear</button>
                            </div>
                            <div class="day-picks" role="radiogroup" aria-labelledby="dateLabel">
                                <input type="radio" name="availableOn" id="dAny" value="" checked="@(!q.AvailableOn.HasValue)" />
                                <label for="dAny"><span class="any">Any day</span></label>
                                @foreach (var d in quickDays)
                                {
                                    var id = $"d{d:yyyyMMdd}";
                                    <input type="radio" name="availableOn" id="@id" value="@d.ToString("yyyy-MM-dd", inv)" checked="@(q.AvailableOn == d)" />
                                    <label for="@id" title="@d.ToString("dddd, d MMMM")">
                                        <span class="dow">@(d == today ? "Today" : d.ToString("ddd"))</span>
                                        <span class="dom">@d.Day</span>
                                        <span class="visually-hidden">@d.ToString("MMMM")</span>
                                    </label>
                                }
                                @* A later date is picked with the browser's calendar (site.js) and stored in this radio. *@
                                <input type="radio" name="availableOn" id="dLater" value="@laterDate?.ToString("yyyy-MM-dd", inv)" checked="@(laterDate.HasValue)" disabled="@(!laterDate.HasValue)" data-date-custom tabindex="-1" aria-hidden="true" />
                            </div>
                            <div class="date-more-wrap">
                                <button type="button" class="date-more @(laterDate.HasValue ? "is-set" : "")" data-date-more>
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <span data-date-text>@(laterDate.HasValue ? laterDate.Value.ToString("ddd, d MMM") : "Pick a later date")</span>
                                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                </button>
                                <input type="date" class="date-more-input" data-date-input aria-label="Later date" tabindex="-1" min="@today.AddDays(7).ToString("yyyy-MM-dd", inv)" max="@today.AddDays(30).ToString("yyyy-MM-dd", inv)" value="@laterDate?.ToString("yyyy-MM-dd", inv)" />
                            </div>
                        </div>

                        <button class="btn btn-navy w-100 filter-submit @(total == 0 ? "is-empty" : "")" type="submit" data-filter-submit>
                            <span data-filter-count>@(total == 0 ? "No matches" : $"Show {total} professional{(total == 1 ? "" : "s")}")</span>
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-9">
                @if (Model.Results.Items.Count == 0)
                {
                    <div class="surface empty">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <h3>No professionals match these filters</h3>
                        <p>Try a different city, widen the price range or pick another date.</p>
                        <a class="btn btn-outline-ink" href="@clearHref">Clear filters</a>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var p in Model.Results.Items)
                        {
                            <div class="col-md-6"><partial name="_ProviderCard" model="p" /></div>
                        }
                    </div>
                    @if (Model.Results.TotalPages > 1)
                    {
                        <nav class="results-pager" aria-label="Result pages">
                            <span class="small-label">Page @Model.Results.Page of @Model.Results.TotalPages</span>
                            <pager page="@Model.Results.Page" total-pages="@Model.Results.TotalPages" />
                        </nav>
                    }
                }

                @if (Model.RecentlyViewed.Count > 0)
                {
                    <h2 class="h4 mt-5 mb-3">Recently viewed</h2>
                    <div class="row g-3">
                        @foreach (var p in Model.RecentlyViewed)
                        {
                            <div class="col-md-6"><partial name="_ProviderCard" model="p" /></div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
