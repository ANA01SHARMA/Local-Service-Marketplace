@model RegisterCustomerViewModel
<section class="auth-wrap">
    <div class="auth-card wide">
        <div class="role-switch" role="tablist" aria-label="Account type">
            <a class="active" asp-action="Register" aria-current="page">I need a service</a>
            <a asp-action="RegisterProvider">I offer a service</a>
        </div>
        <div class="surface surface-pad">
            <h1 class="h2 mb-1">Create your account</h1>
            <p class="text-muted">Book verified professionals and track every job in one place.</p>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <partial name="_RegisterFields" model="Model" />
                <div class="form-check mt-3">
                    <input asp-for="AcceptTerms" class="form-check-input" />
                    <label asp-for="AcceptTerms" class="form-check-label">I agree to the <a asp-controller="Home" asp-action="Terms" target="_blank">terms and cancellation policy</a></label>
                    <div><span asp-validation-for="AcceptTerms"></span></div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Create account</button>
            </form>
            <p class="small text-center mt-4 mb-0">Already registered? <a asp-action="Login">Sign in</a></p>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
