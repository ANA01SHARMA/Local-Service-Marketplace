@model ResetPasswordViewModel
<section class="auth-wrap">
    <div class="auth-card">
        <div class="surface surface-pad">
            <h1 class="h2 mb-1">Choose a new password</h1>
            <p class="text-muted">For <strong>@Model.Email</strong></p>
            <form asp-action="ResetPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
                <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Save new password</button>
            </form>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
