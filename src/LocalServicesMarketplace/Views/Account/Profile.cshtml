@model ProfileViewModel
@{
    Layout = "_DashboardLayout";
    var cities = (IReadOnlyList<string>)ViewBag.Cities;
}
<div class="row g-4">
    <div class="col-xl-8">
        <form asp-action="Profile" method="post" enctype="multipart/form-data" class="surface" novalidate>
            <div class="surface-head"><h2>Personal details</h2><span class="small text-muted">Member since @Tz.Format(Model.MemberSinceUtc, "MMMM yyyy")</span></div>
            <div class="surface-pad">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="d-flex align-items-center gap-3 mb-4">
                    <avatar name="@Model.FullName" src="@Model.ProfileImagePath" size="lg" />
                    <div>
                        <label asp-for="Photo" class="form-label mb-1"></label>
                        <input asp-for="Photo" type="file" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">JPG, PNG or WEBP, up to 2 MB.</div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName"></span></div>
                    <div class="col-md-6"><label class="form-label" for="emailRo">E-mail</label><input id="emailRo" class="form-control" value="@Model.Email" readonly /></div>
                    <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber"></span></div>
                    <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" list="cityList" /><datalist id="cityList">@foreach (var c in cities) { <option value="@c"></option> }</datalist></div>
                    <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea><div class="form-text">Used to pre-fill new bookings.</div></div>
                </div>
                <button class="btn btn-primary mt-4" type="submit">Save profile</button>
            </div>
        </form>
    </div>
    <div class="col-xl-4">
        <form asp-action="ChangePassword" method="post" class="surface" novalidate>
            <div class="surface-head"><h2>Change password</h2></div>
            <div class="surface-pad d-grid gap-3">
                <div><label class="form-label" for="Password_CurrentPassword">Current password</label><input class="form-control" type="password" id="Password_CurrentPassword" name="Password.CurrentPassword" autocomplete="current-password" required /></div>
                <div><label class="form-label" for="Password_NewPassword">New password</label><input class="form-control" type="password" id="Password_NewPassword" name="Password.NewPassword" autocomplete="new-password" minlength="8" required /></div>
                <div><label class="form-label" for="Password_ConfirmPassword">Confirm new password</label><input class="form-control" type="password" id="Password_ConfirmPassword" name="Password.ConfirmPassword" autocomplete="new-password" minlength="8" required /></div>
                <button class="btn btn-navy" type="submit">Update password</button>
            </div>
        </form>
        @if (Model.Role == AppRoles.Provider)
        {
            <div class="surface surface-pad mt-4">
                <h2 class="h5">Professional details</h2>
                <p class="small text-muted">Your headline, skills, category and service areas are edited on your professional profile.</p>
                <a class="btn btn-outline-ink btn-sm" asp-controller="Provider" asp-action="Profile">Edit professional profile</a>
            </div>
        }
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
