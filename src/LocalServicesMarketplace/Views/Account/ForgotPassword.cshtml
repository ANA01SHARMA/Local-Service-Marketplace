@model ForgotPasswordViewModel
<section class="auth-wrap">
    <div class="auth-card">
        <div class="surface surface-pad">
            <h1 class="h2 mb-1">Reset your password</h1>
            <p class="text-muted">Enter the e-mail you registered with. We'll send a link to choose a new password.</p>
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div class="mb-3"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" class="form-control" autocomplete="email" autofocus /><span asp-validation-for="Email"></span></div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Send reset link</button>
            </form>
            <p class="small text-center mt-4 mb-0"><a asp-action="Login">Back to sign in</a></p>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
