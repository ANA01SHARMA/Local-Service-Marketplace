<section class="auth-wrap">
    <div class="text-center" style="max-width:520px">
        <i class="bi bi-shield-lock display-4" style="color:var(--navy)" aria-hidden="true"></i>
        <h1 class="h2 mt-3">This page isn't available to your account</h1>
        <p class="text-muted mx-auto">Each dashboard is only open to its own role. Customers, professionals and admins see different areas.</p>
        <div class="d-flex gap-2 justify-content-center">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="Logout" method="post"><button class="btn btn-outline-ink" type="submit">Sign in as someone else</button></form>
            }
        </div>
    </div>
</section>
