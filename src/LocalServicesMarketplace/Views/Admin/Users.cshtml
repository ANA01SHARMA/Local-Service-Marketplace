@model PagedResult<UserListItemVm>
@{ var q = (AdminUserQuery)ViewData["Query"]!; var me = User.GetUserId(); }
<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <label class="visually-hidden" for="uq">Search</label>
    <input id="uq" class="form-control" style="max-width:300px" type="search" name="q" value="@q.Q" placeholder="Name, e-mail, phone or city" />
    <label class="visually-hidden" for="ur">Role</label>
    <select id="ur" name="role" class="form-select" style="max-width:170px" data-autosubmit>
        <option value="">All roles</option>
        @foreach (var r in AppRoles.All) { <option selected="@(q.Role == r)">@r</option> }
    </select>
    <label class="visually-hidden" for="us">Status</label>
    <select id="us" name="status" class="form-select" style="max-width:170px" data-autosubmit>
        <option value="">Any status</option><option value="active" selected="@(q.Status == "active")">Active</option><option value="blocked" selected="@(q.Status == "blocked")">Blocked</option>
    </select>
    <button class="btn btn-outline-ink" type="submit">Filter</button>
</form>
<div class="surface">
    <div class="table-responsive">
        <table class="table table-clean">
            <thead><tr><th>User</th><th>Role</th><th>City</th><th class="text-end">Bookings</th><th>Joined</th><th>Last sign-in</th><th>Status</th><th class="text-end"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td><div class="cell-person"><avatar name="@u.FullName" src="@u.ProfileImagePath" size="sm" /><div><span class="fw-650">@u.FullName</span> @if (u.IsSampleData) { <span class="demo-badge">Demo</span> }<div class="cell-sub">@u.Email</div></div></div></td>
                        <td>@u.Role</td>
                        <td>@u.City</td>
                        <td class="text-end tabular">@u.BookingCount</td>
                        <td class="text-nowrap">@Tz.Format(u.CreatedAtUtc, "d MMM yyyy")</td>
                        <td class="text-nowrap">@(u.LastLoginAtUtc.HasValue ? Tz.Relative(u.LastLoginAtUtc.Value) : "Never")</td>
                        <td>@if (u.IsBlocked) { <span class="badge-status status-rejected" title="@u.BlockedReason">Blocked</span> } else { <span class="badge-status status-completed">Active</span> }</td>
                        <td class="text-end">
                            @if (u.Role != AppRoles.Admin && u.Id != me)
                            {
                                if (u.IsBlocked)
                                {
                                    <form asp-action="Unblock" asp-route-id="@u.Id" method="post"><input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" /><button class="btn btn-soft-success btn-sm" type="submit">Unblock</button></form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-soft-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reasonModal" data-action="@Url.Action("Block", new { id = u.Id })"
                                            data-title="Block @u.FullName?" data-body="They will be signed out immediately and cannot sign in until unblocked.@(u.Role == AppRoles.Provider ? " Their profile will be hidden from customers." : "")"
                                            data-confirm="Block account" data-reason-required="true" data-placeholder="Reason (required, kept on record)">Block</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count == 0) { <div class="empty"><i class="bi bi-people" aria-hidden="true"></i><h3>No users match</h3><p>Try a different search or filter.</p></div> }
</div>
<div class="d-flex justify-content-between align-items-center mt-3"><span class="small text-muted">@Model.TotalCount user@(Model.TotalCount == 1 ? "" : "s")</span><pager page="@Model.Page" total-pages="@Model.TotalPages" /></div>
