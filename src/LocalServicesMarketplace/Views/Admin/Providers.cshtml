@model PagedResult<ProviderAdminListItemVm>
@{ var q = (AdminProviderQuery)ViewData["Query"]!; var categories = (IReadOnlyList<Category>)ViewBag.Categories; }
<nav class="tabs-underline scroll-x" data-scroll-x aria-label="Filter by verification">
    <a class="@(q.Status is null ? "active" : "")" asp-action="Providers">All</a>
    @foreach (var s in Enum.GetValues<VerificationStatus>())
    {
        <a class="@(q.Status == s ? "active" : "")" asp-action="Providers" asp-route-status="@s">@s.Label()</a>
    }
</nav>
<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input type="hidden" name="status" value="@q.Status" />
    <label class="visually-hidden" for="pq">Search</label>
    <input id="pq" class="form-control" style="max-width:300px" type="search" name="q" value="@q.Q" placeholder="Name, e-mail or city" />
    <label class="visually-hidden" for="pc">Category</label>
    <select id="pc" name="categoryId" class="form-select" style="max-width:200px" data-autosubmit>
        <option value="">All categories</option>
        @foreach (var c in categories) { <option value="@c.Id" selected="@(q.CategoryId == c.Id)">@c.Name</option> }
    </select>
    <button class="btn btn-outline-ink" type="submit">Filter</button>
</form>
<div class="surface"><partial name="_ProviderTable" model="Model.Items" /></div>
<div class="d-flex justify-content-between align-items-center mt-3"><span class="small text-muted">@Model.TotalCount provider@(Model.TotalCount == 1 ? "" : "s")</span><pager page="@Model.Page" total-pages="@Model.TotalPages" /></div>
