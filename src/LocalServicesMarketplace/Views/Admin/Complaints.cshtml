@model PagedResult<ComplaintListItemVm>
@{ ComplaintStatus? status = ViewBag.Status; var returnUrl = Context.Request.Path + Context.Request.QueryString; }
<nav class="tabs-underline scroll-x" data-scroll-x aria-label="Filter complaints">
    <a class="@(status is null ? "active" : "")" asp-action="Complaints">All</a>
    @foreach (var s in Enum.GetValues<ComplaintStatus>()) { <a class="@(status == s ? "active" : "")" asp-action="Complaints" asp-route-status="@s">@s.Label()</a> }
</nav>
@if (Model.Items.Count == 0) { <div class="surface empty"><i class="bi bi-emoji-smile" aria-hidden="true"></i><h3>No complaints here</h3><p>Complaints raised by customers and providers appear here.</p></div> }
<div class="d-grid gap-3">
    @foreach (var c in Model.Items)
    {
        <article class="surface">
            <div class="surface-pad">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div>
                        <h2 class="h5 mb-1">#@c.Id @c.Subject @if (c.IsSampleData) { <span class="demo-badge">Demo</span> }</h2>
                        <div class="small text-muted">@c.ComplainantName (@c.ComplainantRole, @c.ComplainantEmail), @Tz.Format(c.CreatedAtUtc)@if (c.BookingId.HasValue) { <span>, booking <a asp-controller="Booking" asp-action="Details" asp-route-id="@c.BookingId">@Booking.FormatReference(c.BookingId.Value)</a></span> }</div>
                    </div>
                    <span class="badge-status @c.Status.BadgeClass() align-self-start">@c.Status.Label()</span>
                </div>
                <p class="mt-3 mb-3">@c.Description</p>
                <form asp-action="UpdateComplaint" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="Id" value="@c.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="col-md-8"><label class="form-label small" for="resp-@c.Id">Response to the user</label><textarea class="form-control" id="resp-@c.Id" name="AdminResponse" rows="2" maxlength="1000">@c.AdminResponse</textarea></div>
                    <div class="col-md-2"><label class="form-label small" for="st-@c.Id">Status</label>
                        <select class="form-select" id="st-@c.Id" name="Status">@foreach (var s in Enum.GetValues<ComplaintStatus>()) { <option value="@s" selected="@(c.Status == s)">@s.Label()</option> }</select></div>
                    <div class="col-md-2"><button class="btn btn-navy w-100" type="submit">Update</button></div>
                </form>
            </div>
        </article>
    }
</div>
<div class="d-flex justify-content-center mt-3"><pager page="@Model.Page" total-pages="@Model.TotalPages" /></div>
