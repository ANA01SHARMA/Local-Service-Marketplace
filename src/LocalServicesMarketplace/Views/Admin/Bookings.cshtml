@model AdminBookingsViewModel
@{
    var q = Model.Query;
    var current = string.IsNullOrEmpty(q.Status) ? "all" : q.Status;
    var tabs = new (string Key, string Label, int Count)[]
    {
        ("all", "All", Model.Counts.Values.Sum()), ("pending", "Pending", Model.Counts[BookingStatus.Pending]), ("confirmed", "Confirmed", Model.Counts[BookingStatus.Confirmed]),
        ("completed", "Completed", Model.Counts[BookingStatus.Completed]), ("cancelled", "Cancelled", Model.Counts[BookingStatus.Cancelled]), ("rejected", "Rejected", Model.Counts[BookingStatus.Rejected])
    };
}
<nav class="tabs-underline scroll-x" data-scroll-x aria-label="Filter by status">
    @foreach (var t in tabs) { <a class="@(current == t.Key ? "active" : "")" asp-action="Bookings" asp-route-status="@(t.Key == "all" ? null : t.Key)">@t.Label <span class="n">@t.Count</span></a> }
</nav>
<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input type="hidden" name="status" value="@q.Status" />
    <label class="visually-hidden" for="bq">Search</label>
    <input id="bq" class="form-control" style="max-width:300px" type="search" name="q" value="@q.Q" placeholder="Reference, customer, provider, service or city" />
    <label class="visually-hidden" for="bf">From</label><input id="bf" class="form-control" style="max-width:170px" type="date" name="from" value="@q.From?.ToString("yyyy-MM-dd")" />
    <label class="visually-hidden" for="bt">To</label><input id="bt" class="form-control" style="max-width:170px" type="date" name="to" value="@q.To?.ToString("yyyy-MM-dd")" />
    <button class="btn btn-outline-ink" type="submit">Filter</button>
    @if (!string.IsNullOrEmpty(q.Q) || q.From.HasValue || q.To.HasValue) { <a class="btn btn-link" asp-action="Bookings" asp-route-status="@q.Status">Clear</a> }
</form>
<div class="surface">
    @if (Model.Results.Items.Count == 0) { <div class="empty"><i class="bi bi-calendar-x" aria-hidden="true"></i><h3>No bookings match</h3><p>Try a different status, search or date range.</p></div> }
    else { <partial name="_BookingTable" model="(Model.Results.Items, BookingScope.Admin)" /> }
</div>
<div class="d-flex justify-content-between align-items-center mt-3"><span class="small text-muted">@Model.Results.TotalCount booking@(Model.Results.TotalCount == 1 ? "" : "s")</span><pager page="@Model.Results.Page" total-pages="@Model.Results.TotalPages" /></div>
