@model ReportsViewModel
@{ string Json(object o) => System.Text.Json.JsonSerializer.Serialize(o); }
@section TopActions { <a class="btn btn-outline-ink btn-sm" asp-action="ExportMonthlyReport" asp-route-year="@Model.Year"><i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV</a> }
<form method="get" class="d-flex align-items-center gap-2 mb-4">
    <label class="form-label m-0" for="year">Year</label>
    <select id="year" name="year" class="form-select" style="max-width:140px" data-autosubmit>@foreach (var y in Model.Years) { <option selected="@(y == Model.Year)">@y</option> }</select>
    <noscript><button class="btn btn-outline-ink" type="submit">Show</button></noscript>
</form>
<div class="kpis mb-4">
    <div class="kpi kpi-lead"><div class="label">Platform revenue @Model.Year</div><div class="value">@Model.YearRevenue.ToMoney()</div><div class="sub">commission on completed jobs</div></div>
    <div class="kpi"><div class="label">Gross booking value</div><div class="value">@Model.YearGross.ToMoney()</div><div class="sub">completed jobs</div></div>
    <div class="kpi"><div class="label">Paid to providers</div><div class="value">@Model.YearPayouts.ToMoney()</div><div class="sub">after commission</div></div>
    <div class="kpi"><div class="label">Bookings created</div><div class="value">@Model.YearBookings</div><div class="sub">all statuses</div></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-7">
        <div class="surface surface-pad h-100">
            <h2 class="h5 mb-0">Platform revenue by month</h2>
            <p class="small text-muted">Source: <code>EXEC dbo.GetMonthlyBookingReport @@Year = @Model.Year</code></p>
            <div class="chart-box">
                <canvas data-chart="bar" data-format="money" data-series="Revenue" data-labels='@Html.Raw(Json(Model.MonthlyReport.Select(r => r.MonthName[..3])))' data-values='@Html.Raw(Json(Model.MonthlyReport.Select(r => r.PlatformRevenue)))'
                        role="img" aria-label="Bar chart of platform revenue by month in @Model.Year. Values are in the monthly report table."></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="surface h-100">
            <div class="surface-head"><h2>Revenue by category</h2><span class="small text-muted">Bookings ⋈ Services ⋈ Categories</span></div>
            <div class="table-responsive">
                <table class="table table-clean">
                    <thead><tr><th>Category</th><th class="text-end">Jobs</th><th class="text-end">Gross</th><th class="text-end">Revenue</th></tr></thead>
                    <tbody>@foreach (var r in Model.CategoryRevenue) { <tr><td>@r.CategoryName</td><td class="text-end tabular">@r.CompletedBookings</td><td class="text-end tabular">@r.GrossValue.ToMoney()</td><td class="text-end tabular fw-650">@r.PlatformRevenue.ToMoney()</td></tr> }</tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="surface mb-4">
    <div class="surface-head"><h2>Monthly booking report, @Model.Year</h2><span class="small text-muted">Stored procedure <code>dbo.GetMonthlyBookingReport</code></span></div>
    <div class="table-responsive">
        <table class="table table-clean">
            <thead><tr><th>Month</th><th class="text-end">Bookings</th><th class="text-end">Completed</th><th class="text-end">Cancelled</th><th class="text-end">Rejected</th><th class="text-end">Active</th><th class="text-end">Customers</th><th class="text-end">Gross value</th><th class="text-end">Revenue</th><th class="text-end">Provider payouts</th></tr></thead>
            <tbody>
                @foreach (var r in Model.MonthlyReport)
                {
                    <tr class="@(r.TotalBookings == 0 ? "text-muted" : "")"><td>@r.MonthName</td><td class="text-end tabular">@r.TotalBookings</td><td class="text-end tabular">@r.CompletedBookings</td><td class="text-end tabular">@r.CancelledBookings</td><td class="text-end tabular">@r.RejectedBookings</td><td class="text-end tabular">@r.ActiveBookings</td><td class="text-end tabular">@r.UniqueCustomers</td><td class="text-end tabular">@r.GrossBookingValue.ToMoney()</td><td class="text-end tabular fw-650">@r.PlatformRevenue.ToMoney()</td><td class="text-end tabular">@r.ProviderPayouts.ToMoney()</td></tr>
                }
            </tbody>
            <tfoot><tr class="fw-650"><td>Total</td><td class="text-end tabular">@Model.YearBookings</td><td class="text-end tabular">@Model.MonthlyReport.Sum(r => r.CompletedBookings)</td><td class="text-end tabular">@Model.MonthlyReport.Sum(r => r.CancelledBookings)</td><td class="text-end tabular">@Model.MonthlyReport.Sum(r => r.RejectedBookings)</td><td class="text-end tabular">@Model.MonthlyReport.Sum(r => r.ActiveBookings)</td><td></td><td class="text-end tabular">@Model.YearGross.ToMoney()</td><td class="text-end tabular">@Model.YearRevenue.ToMoney()</td><td class="text-end tabular">@Model.YearPayouts.ToMoney()</td></tr></tfoot>
        </table>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="surface h-100">
            <div class="surface-head"><h2>Provider performance</h2><span class="small text-muted">View <code>dbo.ProviderPerformance</code></span></div>
            <div class="table-responsive">
                <table class="table table-clean">
                    <thead><tr><th>Provider</th><th class="text-end">Bookings</th><th class="text-end">Completed</th><th class="text-end">Completion</th><th class="text-end">Rating</th><th class="text-end">Earnings</th></tr></thead>
                    <tbody>@foreach (var p in Model.ProviderPerformance) { <tr><td><a class="fw-650 text-body text-decoration-none" asp-action="ReviewProvider" asp-route-id="@p.ProviderId">@p.ProviderName</a><div class="cell-sub">@p.CategoryName, @p.City</div></td><td class="text-end tabular">@p.TotalBookings</td><td class="text-end tabular">@p.CompletedJobs</td><td class="text-end tabular">@p.CompletionRate.ToString("0")%</td><td class="text-end tabular">@(p.TotalReviews > 0 ? p.AverageRating.ToString("0.00") : "–")</td><td class="text-end tabular fw-650">@p.TotalEarnings.ToMoney()</td></tr> }</tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="surface h-100">
            <div class="surface-head"><h2>Top customers</h2><span class="small text-muted">Bookings ⋈ Users</span></div>
            <div class="table-responsive">
                <table class="table table-clean">
                    <thead><tr><th>Customer</th><th class="text-end">Bookings</th><th class="text-end">Spent</th></tr></thead>
                    <tbody>@foreach (var c in Model.TopCustomers) { <tr><td><span class="fw-650">@c.CustomerName</span><div class="cell-sub">@c.City, last booked @(c.LastBookingUtc.HasValue ? Tz.Format(c.LastBookingUtc.Value, "d MMM") : "–")</div></td><td class="text-end tabular">@c.TotalBookings<div class="cell-sub">@c.CompletedBookings done, @c.CancelledBookings cancelled</div></td><td class="text-end tabular fw-650">@c.TotalSpent.ToMoney()</td></tr> }</tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts { <script src="~/lib/chartjs/chart.umd.min.js"></script><script src="~/js/charts.js" asp-append-version="true"></script> }
