<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Kaarigar</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-primary" style="z-index:2000" href="#dash-main">Skip to content</a>
    <div class="dash">
        <partial name="_Sidebar" />
        <div class="dash-backdrop"></div>
        <div class="dash-main">
            @if (User.HasClaim("must_change_password", "true"))
            {
                <div class="dev-banner"><i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>You are using the seeded admin password. <a asp-controller="Account" asp-action="Profile" class="fw-650">Change it now</a>.</div>
            }
            <header class="dash-top">
                <button class="icon-btn d-lg-none" type="button" data-sidebar-toggle aria-label="Open menu"><i class="bi bi-list" aria-hidden="true"></i></button>
                <h1>@ViewData["Title"]</h1>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @await RenderSectionAsync("TopActions", required: false)
                    @await Component.InvokeAsync("NotificationBell")
                    <div class="dropdown">
                        <button class="btn p-0 border-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                            <avatar name="@User.DisplayName()" src="@User.FindFirst("avatar")?.Value" size="sm" />
                            <span class="d-none d-md-inline fw-650 small">@User.DisplayName()</span>
                            <i class="bi bi-chevron-down small text-muted d-none d-md-inline" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2" aria-hidden="true"></i>Back to website</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2" aria-hidden="true"></i>My profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button></form></li>
                        </ul>
                    </div>
                </div>
            </header>
            <div class="dash-content" id="dash-main">
                @RenderBody()
            </div>
        </div>
    </div>

    <partial name="_ReasonModal" />
    <partial name="_Flash" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
