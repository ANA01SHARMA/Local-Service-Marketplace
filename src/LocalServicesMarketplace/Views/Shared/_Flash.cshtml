@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
@if (!string.IsNullOrEmpty(success) || !string.IsNullOrEmpty(error))
{
    <div class="toast-stack" role="status" aria-live="polite">
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="toast-msg"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>@success</span><button type="button" aria-label="Dismiss"><i class="bi bi-x-lg"></i></button></div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="toast-msg" data-autohide="false"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i><span>@error</span><button type="button" aria-label="Dismiss"><i class="bi bi-x-lg"></i></button></div>
        }
    </div>
}
