<section class="auth-wrap">
    <div class="text-center" style="max-width:560px">
        <i class="bi bi-cone-striped display-4 text-warning" aria-hidden="true"></i>
        <h1 class="mt-3">Something went wrong on our side</h1>
        <p class="text-muted mx-auto">The error has been logged. Try again in a moment, or go back to the home page.</p>
        <p class="small text-muted">Reference: <code>@ViewBag.TraceId</code></p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
        @if (ViewBag.Details is string details)
        {
            <details class="text-start mt-4"><summary class="small">Developer details (Development only)</summary><pre class="small bg-white border rounded p-3 mt-2" style="white-space:pre-wrap">@details</pre></details>
        }
    </div>
</section>
