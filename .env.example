# Copy to .env and adjust. .env is git-ignored.
# These are DEMO / DEVELOPMENT values only - this stack is not hardened for production.

# --- SQL Server ---------------------------------------------------------------
# Must satisfy SQL Server complexity rules (8+ chars, upper, lower, digit, symbol)
MSSQL_SA_PASSWORD=Lsm_Dev_Passw0rd!
DB_NAME=LocalServicesMarketplace
DB_HOST_PORT=14333

# --- Web app ------------------------------------------------------------------
APP_HOST_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# Signing key for API JWTs (32+ characters)
JWT_KEY=dev-only-change-me-0123456789-abcdefghijklmnop

# --- Development seeding --------------------------------------------------------
# Seeding only runs when ASPNETCORE_ENVIRONMENT=Development and SEED_ENABLED=true.
SEED_ENABLED=true
SEED_SAMPLE_DATA=true
# Initial admin account. Change the password after first login (Admin > My profile).
ADMIN_EMAIL=admin@lsm.local
ADMIN_PASSWORD=Admin@Lsm2026!
# Password shared by all seeded demo customers / providers
DEMO_USER_PASSWORD=Demo@12345
# 0 = different random sample data on every fresh database. Put the seed printed in the app log
# ("Seeding sample data with random seed N") here to get exactly the same dataset again.
SEED_RANDOM_SEED=0

# --- Mailpit --------------------------------------------------------------------
MAILPIT_UI_PORT=8025
